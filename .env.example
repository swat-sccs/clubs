# Postgres. Compose constructs DATABASE_URL from these values.
POSTGRES_USER=clubs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clubs

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=change-me
# Separate HMAC key for database-backed request-rate-limit identifiers.
RATE_LIMIT_SECRET=change-me
# Only enable this when the app is reachable exclusively through a trusted proxy.
TRUST_PROXY_HEADERS=true
# Public URL of the deployed site.
AUTH_URL=https://clubs.sccs.swarthmore.edu
AUTH_TRUST_HOST=true
# Keycloak group whose members can review requests and edit every club.
KEYCLOAK_ADMIN_GROUP=sccs-staff

# Must match in the web and matcher containers.
CLUB_VISIBILITY_GRACE_DAYS=14

# Club matching. EMBEDDINGS_URL is the campus TEI server (campus network
# only); MATCHER_URL is where the Next.js app reaches the Go matcher service.
EMBEDDINGS_URL=http://loon.sccs.swarthmore.edu:8001
MATCHER_URL=http://clubs-matcher:8080

# SCCS Keycloak confidential client (realm master).
AUTH_KEYCLOAK_ID=clubs
AUTH_KEYCLOAK_SECRET=change-me
AUTH_KEYCLOAK_ISSUER=https://auth.sccs.swarthmore.edu/realms/master

# SeaweedFS S3-compatible image storage. Compose maps these credentials into
# the private SeaweedFS service and sets the app's internal S3 endpoint.
S3_ACCESS_KEY_ID=clubs-app
S3_SECRET_ACCESS_KEY=change-me-to-a-long-random-password
S3_REGION=us-east-1
S3_BUCKET_NAME=club-uploads

# NSFWJS review thresholds. Drawing and Neutral are treated as safe; the
# sexual-content classes below queue a post for human review.
NSFW_PORN_THRESHOLD=0.25
NSFW_HENTAI_THRESHOLD=0.25
NSFW_SEXY_THRESHOLD=0.45
NSFW_COMBINED_THRESHOLD=0.50
# Keep CPU- and memory-heavy image classification serialized by default.
MODERATION_CONCURRENCY=1
