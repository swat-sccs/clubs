# Postgres. In docker compose the host is the clubs-db service; keep the
# password in sync with POSTGRES_PASSWORD (used to initialize the container).
DATABASE_URL=postgresql://clubs:change-me@clubs-db:5432/clubs
POSTGRES_PASSWORD=change-me

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=change-me
# Public URL of the deployed site (behind Traefik).
AUTH_URL=https://clubs.sccs.swarthmore.edu
AUTH_TRUST_HOST=true

# Club matching. EMBEDDINGS_URL is the campus TEI server (campus network
# only); MATCHER_URL is where the Next.js app reaches the Go matcher service.
EMBEDDINGS_URL=http://loon.sccs.swarthmore.edu:8001
MATCHER_URL=http://clubs-matcher:8080

# SCCS Keycloak confidential client (realm master).
AUTH_KEYCLOAK_ID=clubs
AUTH_KEYCLOAK_SECRET=change-me
AUTH_KEYCLOAK_ISSUER=https://auth.sccs.swarthmore.edu/realms/master
