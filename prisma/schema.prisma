generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubAccessRole {
  OWNER
  EDITOR
}

enum PostModerationStatus {
  PENDING_REVIEW
  PUBLISHED
  DENIED
}

// Local application profile for SCCS users who have completed a sign-in.
// Authentication remains in Keycloak; this record supports role management
// and does not contain credentials or session tokens.
model AppUser {
  id       String  @id
  username String? @unique
  name     String?
  email    String?

  isDirectoryAdmin Boolean @default(false)
  isAppAdmin       Boolean @default(false)

  firstSignedInAt DateTime @default(now())
  lastSignedInAt  DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastSignedInAt])
  @@index([isAppAdmin, lastSignedInAt])
}

model Club {
  id                 String   @id @default(cuid())
  // Display order: seed order for imported clubs, insertion order after that.
  position           Int      @default(autoincrement())
  slug               String   @unique
  name               String   @unique
  description        String
  tags               String[]
  size               String
  isAcceptingMembers Boolean
  membershipProcess  String
  recruitingCycle    String

  instagram     String?
  email         String?
  website       String?
  meetingInfo   String?
  logoObjectKey String?

  // Null follows the automatic visibility rule for unclaimed clubs. Admins
  // can explicitly publish (true) or hide (false) a club.
  visibilityOverride Boolean?

  // Keycloak subject / email / display name of the SCCS account that
  // created or last edited the club. Null for seeded rows.
  createdById String?
  createdBy   String?
  updatedById String?
  updatedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embedding       ClubEmbedding?
  editors         ClubEditor[]
  claimRequests   ClubClaimRequest[]
  creationRequest ClubCreationRequest?
  auditLogs       ClubAuditLog[]
  posts           ClubPost[]
  followers       ClubFollow[]
}

model ClubFollow {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, createdAt])
}

model ClubPost {
  id             String  @id @default(cuid())
  clubId         String
  title          String
  subtitle       String
  imageObjectKey String?
  eventDate      String
  eventTime      String
  location       String
  rsvpCount      Int     @default(0)

  moderationStatus       PostModerationStatus @default(PUBLISHED)
  moderationReason       String?
  moderationNote         String?
  imageModerationFlagged Boolean              @default(false)
  approvedTextHash       String?
  approvedImageObjectKey String?
  moderationReviewedById String?
  moderationReviewedBy   String?
  moderationReviewedAt   DateTime?

  authorId   String
  authorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club  Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rsvps PostRsvp[]

  @@index([createdAt])
  @@index([moderationStatus, createdAt])
  @@index([clubId, createdAt])
  @@index([eventDate, eventTime])
}

model PostRsvp {
  id            String   @id @default(cuid())
  postId        String
  browserIdHash String
  createdAt     DateTime @default(now())

  post ClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, browserIdHash])
  @@index([browserIdHash])
}

model ClubEditor {
  id       String         @id @default(cuid())
  clubId   String
  userId   String
  name     String?
  email    String?
  username String?
  // OWNER is the primary-contact designation. Both roles can edit club
  // content; only application administrators can grant or revoke access.
  role     ClubAccessRole @default(EDITOR)

  grantedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ClubCreationRequest {
  id                 String        @id @default(cuid())
  status             RequestStatus @default(PENDING)
  name               String
  description        String
  tags               String[]
  size               String
  isAcceptingMembers Boolean
  membershipProcess  String
  recruitingCycle    String
  instagram          String?
  email              String?
  website            String?
  meetingInfo        String?

  requesterId       String
  requesterName     String?
  requesterEmail    String?
  requesterUsername String?
  pendingKey        String? @unique

  reviewedById String?
  reviewedBy   String?
  reviewedAt   DateTime?

  clubId String? @unique
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requesterId, status])
}

model ClubClaimRequest {
  id          String        @id @default(cuid())
  status      RequestStatus @default(PENDING)
  clubId      String
  requesterId String
  role        String
  explanation String

  requesterName     String?
  requesterEmail    String?
  requesterUsername String?
  pendingKey        String? @unique

  reviewedById String?
  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([clubId, requesterId, status])
}

// Append-only history for administrator visibility into club changes and
// access grants. The identifying club name is retained if a club is removed.
model ClubAuditLog {
  id       String  @id @default(cuid())
  clubId   String?
  clubName String
  action   String
  summary  String

  actorId    String?
  actor      String?
  actorEmail String?

  createdAt DateTime @default(now())

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([clubId, createdAt])
}

// Written and read by the Go matcher service (matcher/), which embeds each
// club via TEI and re-embeds whenever the club row is newer than this one.
model ClubEmbedding {
  clubId    String   @id
  model     String
  vector    Float[]
  updatedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}
