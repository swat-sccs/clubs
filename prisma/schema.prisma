generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id                 String   @id @default(cuid())
  // Display order: seed order for imported clubs, insertion order after that.
  position           Int      @default(autoincrement())
  slug               String   @unique
  name               String   @unique
  description        String
  tags               String[]
  affiliation        String
  size               String
  isAcceptingMembers Boolean
  membershipProcess  String
  recruitingCycle    String

  instagram   String?
  email       String?
  website     String?
  meetingInfo String?

  // Keycloak subject / email / display name of the SCCS account that
  // created or last edited the club. Null for seeded rows.
  createdById String?
  createdBy   String?
  updatedById String?
  updatedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embedding ClubEmbedding?
}

// Written and read by the Go matcher service (matcher/), which embeds each
// club via TEI and re-embeds whenever the club row is newer than this one.
model ClubEmbedding {
  clubId    String   @id
  model     String
  vector    Float[]
  updatedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}
