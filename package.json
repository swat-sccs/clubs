{
  "name": "clubs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:matcher": "cd matcher && go test ./... && go vet ./...",
    "prisma:validate": "DATABASE_URL=postgresql://validation:validation@localhost:5432/validation bunx prisma validate",
    "check": "bun run prisma:validate && bunx prisma generate && bun run lint && bun run typecheck && bun test && bun run test:matcher"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@img/sharp-wasm32": "0.35.4",
    "@prisma/client": "6",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "nsfwjs": "^4.4.0",
    "obscenity": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.22",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
